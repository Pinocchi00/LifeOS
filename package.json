{
  "name": "lifeos",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "android:sync": "npm run build && cap sync android",
    "android:add": "cap add android",
    "android:build": "node scripts/android-build.mjs",
    "android:verify": "node scripts/android-build.mjs --verify",
    "connector:start": "node scripts/connector-start.mjs",
    "test:server": "node --test server/*.test.mjs",
    "connector:setup": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/Start-Connector.ps1"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "8.4.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/local-notifications": "^8.3.1",
    "@capacitor/share": "^8.0.3",
    "idb": "^8.0.4",
    "lucide-react": "^1.59.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/android": "8.4.3",
    "@capacitor/cli": "8.4.3",
    "@playwright/test": "^1.64.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fake-indexeddb": "^6.2.6",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
